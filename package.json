{
  "name": "OcrLens",
  "version": "0.1.0",
  "private": true,
  "description": "OcrLens - visual desktop client for the open-code-review (ocr) CLI",
  "author": "haoyang",
  "main": "./out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "compile": "electron-vite build",
    "build": "yarn compile && set \"ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/\" && set \"HTTPS_PROXY=http://127.0.0.1:7890\" && electron-builder",
    "build:unpack": "yarn compile && set \"ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/\" && set \"HTTPS_PROXY=http://127.0.0.1:7890\" && electron-builder --dir",
    "start": "electron-vite preview",
    "postinstall": "install-electron",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "yarn typecheck:node && yarn typecheck:web",
    "smoke:check": "node --check scripts/smoke.cjs",
    "smoke": "yarn smoke:check && electron scripts/smoke.cjs",
    "probe:check": "node --check scripts/probe-ui.cjs && node --check scripts/probe-rails.cjs",
    "probe:ui": "yarn probe:check && electron scripts/probe-ui.cjs",
    "probe:rails": "yarn probe:check && electron scripts/probe-rails.cjs",
    "video:check": "node --check scripts/make-video.cjs",
    "video": "yarn compile && yarn video:check && electron scripts/make-video.cjs",
    "promo:check": "node --check scripts/make-promo.cjs && node --check build/stage/stage.js",
    "promo": "yarn promo:check && electron scripts/make-promo.cjs",
    "promo:diag": "yarn promo:check && electron scripts/make-promo.cjs --diag"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/devtools-api": "^8.1.5",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "pinia": "^4.0.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
